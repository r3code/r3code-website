---
/**
 * /articles/<slug>/ — internal article page (articles without an external url).
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACTS, withBase } from '../../consts';

export async function getStaticPaths() {
  const internalArticles = (await getCollection('articles')).filter(
    (article) => !article.data.url,
  );

  for (const article of internalArticles) {
    if (!article.body || !article.body.trim()) {
      throw new Error(
        `Внутренняя статья "${article.id}" без url должна иметь Markdown-тело. Либо добавь тело, либо укажи внешний url. См. docs/CONTENT.md.`,
      );
    }
  }

  return internalArticles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, date, teaser, tags } = article.data;
const { Content } = await render(article);

const displayDate = date.split('-').reverse().join('.');

const seoTitle = `${title} — статья | r3code.ru`;
const seoDescription = teaser;
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <article class="section article-detail">
    <div class="container article-detail__inner">
      <a href={withBase('articles/')} class="article-detail__back">
        <span aria-hidden="true">←</span> Все статьи
      </a>

      <header class="article-detail__head">
        <p class="article-detail__meta">
          <span class="article-detail__type">Статья</span>
          <span class="article-detail__sep" aria-hidden="true">·</span>
          <time datetime={date}>{displayDate}</time>
        </p>

        <h1>{title}</h1>

        <ul class="article-detail__tags">
          {tags.map((tag) => (
            <li class="article-detail__tag">{tag}</li>
          ))}
        </ul>

        {teaser && <p class="article-detail__teaser">{teaser}</p>}
      </header>

      {/* === Body (Markdown) === */}
      <div class="article-detail__body">
        <Content />
      </div>

      {/* === CTA: get in touch === */}
      <aside class="article-detail__cta">
        <p>
          Хотите обсудить похожий кейс для своей команды? Напишите мне в
          Telegram — отвечаю в течение 24 часов.
        </p>
        <a class="btn btn--primary" href={CONTACTS.telegramUrl} target="_blank" rel="noopener">
          Написать в Telegram <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-detail__inner {
    max-width: 760px;
  }

  .article-detail__back {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .article-detail__back:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .article-detail__head {
    margin-bottom: 2rem;
  }

  .article-detail__head h1 {
    font-size: clamp(1.7rem, 2vw + 1rem, 2.3rem);
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .article-detail__meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .article-detail__type {
    color: var(--color-accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .article-detail__sep {
    color: var(--color-border-strong);
  }

  /* Tags row */
  .article-detail__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin: 0 0 0.75rem;
  }

  .article-detail__tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background: var(--color-bg-muted);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .article-detail__teaser {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* Markdown body */
  .article-detail__body {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .article-detail__body :global(h2) {
    font-size: 1.3rem;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-detail__body :global(h3) {
    font-size: 1.1rem;
    color: var(--color-text);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .article-detail__body :global(p) {
    margin-bottom: 1rem;
  }

  .article-detail__body :global(ul) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .article-detail__body :global(li) {
    margin-bottom: 0.4rem;
  }

  .article-detail__body :global(code) {
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }

  .article-detail__body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  /* CTA block */
  .article-detail__cta {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-lg);
  }

  .article-detail__cta p {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
</style>

<script>
  // Fire 'view_article_detail' goal once when the article page loads.
  if (typeof window.reachGoal === 'function') {
    window.reachGoal('view_article_detail');
  } else {
    // Wait for Metrika to load (in case it's slow or blocked).
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof window.reachGoal === 'function') {
        window.reachGoal('view_article_detail');
      }
    });
  }
</script>
