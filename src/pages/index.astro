---
/**
 * Homepage — portfolio of expertise.
 *
 * Feature flags allow toggling sections on/off without deleting code.
 * Set to false to exclude from build (Astro tree-shakes unused imports).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Conferences from '../components/Conferences.astro';
import Artifacts from '../components/Artifacts.astro';
import CaseMigration from '../components/CaseMigration.astro';
import Process from '../components/Process.astro';
import Community from '../components/Community.astro';
import FeaturedTalks from '../components/FeaturedTalks.astro';
import Tools from '../components/Tools.astro';
import Checklist from '../components/Checklist.astro';
import About from '../components/About.astro';
import ExpertSupport from '../components/ExpertSupport.astro';

const FEATURES = {
  conferences: false,
  artifacts: false,
  caseMigration: false,
  process: false,
};
---

<BaseLayout>
  <Hero />
  {FEATURES.conferences && <Conferences />}
  {FEATURES.artifacts && <Artifacts />}
  {FEATURES.caseMigration && <CaseMigration />}
  {FEATURES.process && <Process />}
  <Community />
  <FeaturedTalks />
  <Tools />
  <Checklist />
  <About />
  <ExpertSupport />
</BaseLayout>
