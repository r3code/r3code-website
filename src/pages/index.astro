---
/**
 * Homepage — portfolio of expertise.
 *
 * Feature flags allow toggling sections on/off without deleting code.
 * Set to false to exclude from build (Astro tree-shakes unused imports).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import Services from '../components/Services.astro';
import CaseStudy from '../components/CaseStudy.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import Community from '../components/Community.astro';
import Cases from '../components/Cases.astro';
import Tools from '../components/Tools.astro';
import About from '../components/About.astro';
import ExpertSupport from '../components/ExpertSupport.astro';

const FEATURES = {
  socialProof: false,
  services: false,
  caseStudy: false,
};
---

<BaseLayout>
  <Hero />
  {FEATURES.socialProof && <SocialProof />}
  {FEATURES.services && <Services />}
  {FEATURES.caseStudy && <CaseStudy />}
  <Community />
  <Cases />
  <Tools />
  <LeadMagnet />
  <About />
  <ExpertSupport />
</BaseLayout>
