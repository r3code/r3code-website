---
/**
 * Cases — top-3 featured talks on the homepage.
 *
 * Pulls from the `talks` content collection by FEATURED_TALK_SLUGS.
 * Each card links to /talks/<slug>/.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { FEATURED_TALK_SLUGS, withBase } from '../consts';

const allTalks = await getCollection('talks');
const talksBySlug = new Map(allTalks.map((t) => [t.id, t]));

const featuredTalks = FEATURED_TALK_SLUGS.map((slug) => talksBySlug.get(slug)).filter(
  (t): t is CollectionEntry<'talks'> => Boolean(t),
);

const talkHref = (slug: string) => withBase(`talks/${slug}/`);
const talkUrl = (slug: string) => `${talkHref(slug)}`;
---

<section class="section cases" id="talks" aria-labelledby="talks-section-title">
  <div class="container">
    <div class="section__head">
      <h2 id="talks-section-title">Доклады</h2>
      <p class="section__lead">
        Топ-3 доклада по оценкам участников. Полный список — на отдельной
        странице со ссылками на видео, презентации и материалы.
      </p>
    </div>

    <ul class="cases__grid">
      {
        featuredTalks.map((talk) => {
          const { title, venue, rating, teaser } = talk.data;
          return (
            <li class="case-card">
              <article>
                <header class="case-card__head">
                  <span class="case-card__venue">{venue}</span>
                  {rating && (
                    <span
                      class="case-card__rating"
                      aria-label={`Оценки: содержание ${rating.content}, подача ${rating.delivery} из 5`}
                    >
                      ★ {rating.content}/{rating.delivery}
                    </span>
                  )}
                </header>
                <h3 class="case-card__title">
                  <a href={talkUrl(talk.id)}>{title}</a>
                </h3>
                <p class="case-card__note">{teaser}</p>
                <a
                  class="case-card__link"
                  href={talkUrl(talk.id)}
                  aria-label={`Открыть доклад: ${title}`}
                >
                  Открыть доклад <span aria-hidden="true">→</span>
                </a>
              </article>
            </li>
          );
        })
      }
    </ul>

    <div class="cases__footer">
      <a class="btn btn--ghost" href={withBase('talks/')}>
        Все доклады →
      </a>
    </div>
  </div>
</section>

<style>
  .cases__grid {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .cases__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .cases__grid > * {
      min-width: 0;
    }
  }

  .case-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color var(--t-med), box-shadow var(--t-med),
      transform var(--t-med);
  }

  .case-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    transform: translateY(-2px);
  }

  .case-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .case-card__venue {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .case-card__rating {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .case-card__title {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .case-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .case-card__title a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .case-card__note {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1rem;
    flex: 1;
  }

  .case-card__link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
    align-self: flex-start;
  }

  .cases__footer {
    text-align: center;
  }
</style>
