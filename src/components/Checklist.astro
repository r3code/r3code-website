---
/**
 * Checklist — checklist CTA section, visually distinct (accent background).
 *
 * Telegram deep link with prefilled message ("AI-чеклист").
 */
import { CHECKLIST } from '../consts';
---

<section class="section section--accent checklist" id="checklist" aria-labelledby="checklist-title">
  <div class="container">
    <div class="checklist__body">
      <h2 id="checklist-title" class="checklist__title">{CHECKLIST.title}</h2>
      <p class="checklist__text">{CHECKLIST.body}</p>

      <div class="checklist__cta">
        <a
          class="btn btn--ghost btn--lg"
          href={CHECKLIST.ctaHref}
          target="_blank"
          rel="noopener"
          onclick="reachGoal('cta_lead_magnet_checklist')"
        >
          {CHECKLIST.ctaLabel}
          <span aria-hidden="true">→</span>
        </a>
        {CHECKLIST.footnote && (
          <p class="checklist__note">{CHECKLIST.footnote}</p>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .checklist__title {
    font-size: clamp(1.6rem, 1.5vw + 1rem, 2rem);
    margin-bottom: 0.75rem;
  }

  .checklist__text {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 68ch;
    margin-bottom: 1.5rem;
  }

  .checklist__cta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .checklist__note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
