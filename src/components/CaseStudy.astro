---
/**
 * CaseStudy — "Реальный кейс: миграция с Elastic-стек на Vector + ClickHouse"
 *
 * Standalone block between Services and Process.
 * Two columns: "Было" (red-tinted bg) vs "Стало" (green-tinted bg).
 * Numbers are bold (via <strong>), text is normal weight.
 * Points rendered as <ul> bullet lists.
 */
const beforePoints = [
  'Серверы Elastic — <strong>810 т.р./мес</strong> за <strong>18 нод</strong> (рост с <strong>4 нод</strong> и <strong>180 т.р./мес</strong> за год)',
  'Хранили логи только за <strong>5 часов</strong>',
  'FluentD терял логи при отправке',
];

const afterPoints = [
  'Серверы — в <strong>2 раза</strong> меньше',
  'Место под лог — в <strong>10 раз</strong> меньше (с <strong>600 байт</strong> до <strong>60 байт</strong> на запись)',
  'Память в пике — до <strong>10 раз</strong> меньше',
  'Хранение — <strong>4 дня</strong> (вместо 5 часов)',
  'Доставка — <strong>99.98–100%</strong>',
];
---

<section class="section case-study-block" id="case-study" aria-labelledby="case-study-title">
  <div class="container">
    <div class="section__head">
      <h3 id="case-study-title">Реальный кейс: миграция с Elastic-стек на Vector + ClickHouse (ВсеИнструменты.ру)</h3>
    </div>

    <div class="case-study-block__grid">
      <div class="case-study-block__col case-study-block__col--before">
        <p class="case-study-block__label">Было</p>
        <ul class="case-study-block__list">
          {beforePoints.map((point) => (
            <li class="case-study-block__point" set:html={point} />
          ))}
        </ul>
      </div>

      <div class="case-study-block__col case-study-block__col--after">
        <p class="case-study-block__label">Стало</p>
        <ul class="case-study-block__list">
          {afterPoints.map((point) => (
            <li class="case-study-block__point" set:html={point} />
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .case-study-block__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .case-study-block__grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .case-study-block__col {
    padding: 24px;
    border-radius: 12px;
  }

  .case-study-block__col--before {
    background: #fef2f2;
    border: 1px solid #fecaca;
  }

  .case-study-block__col--after {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
  }

  .case-study-block__label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .case-study-block__col--before .case-study-block__label {
    color: #dc2626;
  }

  .case-study-block__col--after .case-study-block__label {
    color: #16a34a;
  }

  .case-study-block__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .case-study-block__point {
    position: relative;
    padding-left: 1.25rem;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    margin-bottom: 0.6rem;
    color: var(--color-text);
  }

  .case-study-block__point:last-child {
    margin-bottom: 0;
  }

  .case-study-block__point::before {
    content: '•';
    position: absolute;
    left: 0;
    top: 0;
  }

  .case-study-block__col--before .case-study-block__point::before {
    color: #dc2626;
  }

  .case-study-block__col--after .case-study-block__point::before {
    color: #16a34a;
  }

  .case-study-block__point strong {
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .case-study-block__point {
      font-size: 16px;
    }
  }
</style>
