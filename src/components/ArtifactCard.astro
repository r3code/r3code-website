---
/**
 * ArtifactCard — single product card.
 *
 * Featured variant (first card) gets text-only badge "ТОП-ЗАПРОС 2026"
 * above the title. No emojis — strict engineering aesthetic.
 */
import type { ArtifactItem } from '../consts';
import { withBase } from '../consts';

interface Props {
  artifact: ArtifactItem;
}

const { artifact } = Astro.props;

/** Convert `inline code` markdown to <code> tags. */
function mdInline(s: string): string {
  // Escape angle brackets first to avoid HTML injection.
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>');
}
---

<article
  class:list={['card', 'artifact-card', { 'card--featured': artifact.featured }]}
  id={artifact.id}
  aria-labelledby={`${artifact.id}-title`}
>
  {artifact.featured && <span class="artifact-card__top-tag">ТОП-ЗАПРОС 2026</span>}

  <h3 class="card__title h3" id={`${artifact.id}-title`}>{artifact.title}</h3>
  <p class="card__subtitle">{artifact.subtitle}</p>
  <p class="card__body">{artifact.description}</p>

  {artifact.details.length > 0 && (
    <ul class="checklist">
      {
        artifact.details.map((detail) => (
          <li set:html={mdInline(detail)} />
        ))
      }
    </ul>
  )}

  {artifact.caseStudy && (
    <div class="artifact-case">
      <p class="artifact-case__title">{artifact.caseStudy.title}</p>
      <div class="artifact-case__group artifact-case__group--before">
        <p class="artifact-case__group-label">Было</p>
        <ul class="artifact-case__list">
          {artifact.caseStudy.beforePoints.map((point) => (
            <li class="artifact-case__point artifact-case__point--before">{point}</li>
          ))}
        </ul>
      </div>
      <div class="artifact-case__group artifact-case__group--after">
        <p class="artifact-case__group-label">Стало</p>
        <ul class="artifact-case__list">
          {artifact.caseStudy.afterPoints.map((point) => (
            <li class="artifact-case__point artifact-case__point--after">{point}</li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <a
    class="btn btn--primary artifact-card__cta"
    href={artifact.cta.href.startsWith('http') ? artifact.cta.href : withBase(artifact.cta.href)}
    aria-label={`${artifact.cta.label} — ${artifact.title}`}
    {...(artifact.cta.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
    {...(artifact.ctaGoal ? { onclick: `reachGoal('${artifact.ctaGoal}')` } : {})}
  >
    {artifact.cta.label}
    <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .artifact-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Text-only top tag for featured card (replaces emoji badge) */
  .artifact-card__top-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
    /* No background, no border — strict engineering style per spec */
  }

  .artifact-card__cta {
    margin-top: auto;
    align-self: flex-start;
    margin-top: 1rem;
    white-space: normal;
    max-width: 100%;
  }

  /* Inline code inside checklist items needs vertical rhythm */
  .artifact-card .checklist li {
    padding-top: 0.1rem;
    font-size: 14px;
    color: #374151;
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .artifact-card .checklist li:last-child {
    margin-bottom: 0;
  }

  .h3 {
    font-size: 1.35rem;
  }

  /* Real-world case study block (featured card only).
     Per spec: numbers are the main selling element — bigger font,
     bold, subtle bg #f9fafb, padding 16px. */
  .artifact-case {
    margin-top: 1.25rem;
    padding: 16px;
    background: #f9fafb;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .artifact-case__title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .artifact-case__group {
    margin-bottom: 0.6rem;
  }

  .artifact-case__group:last-child {
    margin-bottom: 0;
  }

  .artifact-case__group-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    font-weight: 600;
    margin: 0 0 0.3rem;
  }

  .artifact-case__group--after .artifact-case__group-label {
    color: var(--color-accent);
  }

  .artifact-case__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .artifact-case__point {
    position: relative;
    padding-left: 1rem;
    margin-bottom: 0.4rem;
    /* Per spec: numbers font 16-18px, bold */
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .artifact-case__point:last-child {
    margin-bottom: 0;
  }

  .artifact-case__point::before {
    content: '·';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .artifact-case__point--before {
    color: var(--color-text-secondary);
  }

  .artifact-case__point--after {
    color: var(--color-text);
  }

  .artifact-case__point--after::before {
    color: var(--color-accent);
    content: '→';
    font-size: 0.85rem;
    top: 0.1rem;
  }
</style>
