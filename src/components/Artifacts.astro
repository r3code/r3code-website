---
/**
 * Artifacts — three product cards.
 *
 * Order is FIXED: log cost optimization (featured) → AI-Ready Observability → SLO audit.
 * First card is visually emphasized (badge + accent border + larger on desktop).
 */
import { ARTIFACTS } from '../consts';
import ArtifactCard from './ArtifactCard.astro';
---

<section class="section artifacts" id="artifacts" aria-labelledby="artifacts-title">
  <div class="container">
    <div class="section__head">
      <h2 id="artifacts-title">Артефакты и практические кейсы</h2>
    </div>

    <div class="artifacts__grid">
      {
        ARTIFACTS.map((artifact) => (
          <ArtifactCard artifact={artifact} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .artifacts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* Grid items default to `min-width: auto`, which means they refuse to
     shrink below the min-content width of their descendants. The CTA
     button label combined with the global `.btn { white-space: nowrap }`
     forces each card's min-content above the 1fr column width at the
     768px breakpoint, blowing the grid out. `min-width: 0` lets each
     card shrink to its allotted track width. */
  .artifacts__grid > * {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .artifacts__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      align-items: stretch;
    }

    /* Featured card spans 1.25 columns visually via raised shadow + slight scale */
    .artifacts__grid > :first-child {
      transform: scale(1.02);
      transform-origin: top left;
      z-index: 1;
    }
  }
</style>
